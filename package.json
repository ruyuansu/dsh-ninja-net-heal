{
  "name": "dsh-ninja-net-heal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repairs external web access by starting NinjaDesktop, enabling its system proxy and TUN, then retrying the failed request.",
  "keywords": ["dsh", "dsh-plugin", "cordis", "network", "proxy", "tun", "ninja-desktop"],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
